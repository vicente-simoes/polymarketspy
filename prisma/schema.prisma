generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConfigScope {
  GLOBAL
  USER
}

enum TradeSide {
  BUY
  SELL
}

enum ActivityType {
  MERGE
  SPLIT
  REDEEM
}

enum PortfolioScope {
  SHADOW_USER
  EXEC_USER
  EXEC_GLOBAL
}

enum CopyDecision {
  EXECUTE
  SKIP
}

enum CopySourceType {
  IMMEDIATE // Large trade, bypassed buffer (executed directly)
  BUFFER // Came from small trade buffer (batched)
  AGGREGATOR // Came from 250ms aggregator (buffer disabled)
}

enum BookSource {
  WS
  REST
}

enum EnrichmentStatus {
  PENDING // WS-first, minimal data only
  ENRICHED // Market metadata filled
  FAILED // Enrichment failed after retries
}

enum LedgerEntryType {
  TRADE_FILL
  MERGE
  SPLIT
  DEPOSIT
  FEE
  MARK
  SETTLEMENT
}

enum EquityPointGranularity {
  M1
  M20
  H2
  H12
  D1
}

enum TradingMode {
  PAPER
  LIVE
}

enum LiveOrderStatus {
  CREATED
  SUBMITTING
  OPEN
  PARTIAL
  FILLED
  CANCELED
  REJECTED
  FAILED
  SUBMISSION_UNKNOWN
}

enum LiveFillOrigin {
  APP
  EXTERNAL
}

enum LiveOrderType {
  FAK
  FOK
  GTC
}

enum LiveOverride {
  INHERIT
  FORCE_ON
  FORCE_OFF
}

model FollowedUser {
  id            String                    @id @default(uuid())
  label         String
  profileWallet String                    @unique
  enabled       Boolean                   @default(true)
  liveOverride  LiveOverride              @default(INHERIT)
  createdAt     DateTime                  @default(now())
  proxies       FollowedUserProxyWallet[]
  guardrails    GuardrailConfig[]
  sizing        CopySizingConfig[]
  copyAttempts  CopyAttempt[]
  liveOrders    LiveOrder[]
}

model FollowedUserProxyWallet {
  id             String @id @default(uuid())
  followedUserId String
  wallet         String @unique

  followedUser FollowedUser @relation(fields: [followedUserId], references: [id], onDelete: Cascade)

  @@index([followedUserId])
}

model GuardrailConfig {
  id             String      @id @default(uuid())
  scope          ConfigScope
  tradingMode    TradingMode @default(PAPER)
  followedUserId String?
  // stored as JSON; worker materializes effective config
  configJson     Json
  updatedAt      DateTime    @updatedAt

  followedUser FollowedUser? @relation(fields: [followedUserId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tradingMode])
  @@index([followedUserId])
}

model CopySizingConfig {
  id             String      @id @default(uuid())
  scope          ConfigScope
  tradingMode    TradingMode @default(PAPER)
  followedUserId String?
  configJson     Json
  updatedAt      DateTime    @updatedAt

  followedUser FollowedUser? @relation(fields: [followedUserId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tradingMode])
  @@index([followedUserId])
}

model Market {
  id          String    @id // Polymarket market id
  conditionId String
  resolvedAt  DateTime?
  closeTime   DateTime?
  active      Boolean   @default(true)

  assets OutcomeAsset[]

  @@index([conditionId])
  @@index([closeTime])
}

model OutcomeAsset {
  id       String @id // asset id
  marketId String
  outcome  String

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
}

model TradeEvent {
  id          String  @id @default(uuid())
  // source: POLYMARKET_API, ALCHEMY (legacy non-canonical), or ONCHAIN_WS (canonical WS-first)
  source      String
  sourceId    String?
  txHash      String?
  logIndex    Int?
  isCanonical Boolean @default(false)

  profileWallet String
  proxyWallet   String?

  marketId String?
  assetId  String?

  // WS-first enrichment support
  enrichmentStatus EnrichmentStatus @default(ENRICHED) // Existing API trades are already enriched
  enrichedAt       DateTime?
  rawTokenId       String? // Outcome token ID from OrderFilled log (non-USDC assetId)
  conditionId      String? // CTF conditionId (filled by enrichment)

  side           TradeSide
  priceMicros    Int // 0..1_000_000
  shareMicros    BigInt
  notionalMicros BigInt
  feeMicros      BigInt?

  eventTime  DateTime
  detectTime DateTime

  createdAt DateTime @default(now())

  @@unique([source, sourceId])
  @@unique([txHash, logIndex])
  @@index([profileWallet, eventTime])
  @@index([proxyWallet, eventTime])
  @@index([assetId, eventTime])
  @@index([enrichmentStatus]) // For efficient pending enrichment queries
}

model TokenMetadataCache {
  tokenId      String    @id // Outcome token ID (BigInt as string)
  conditionId  String? // CTF conditionId (from on-chain or API)
  marketId     String? // Polymarket market ID
  marketSlug   String? // For display/linking
  outcomeLabel String? // "Yes" / "No" / custom outcome
  marketTitle  String? // Full market question
  closeTime    DateTime? // Market close time
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([conditionId])
  @@index([marketId])
}

model ActivityEvent {
  id          String  @id @default(uuid())
  source      String
  sourceId    String
  isCanonical Boolean @default(false)

  profileWallet String
  proxyWallet   String?

  type        ActivityType
  // store involved asset ids and amounts in JSON
  payloadJson Json

  eventTime  DateTime
  detectTime DateTime

  createdAt DateTime @default(now())

  @@unique([source, sourceId])
  @@index([profileWallet, eventTime])
}

model CopyAttempt {
  id             String         @id @default(uuid())
  tradingMode    TradingMode    @default(PAPER)
  portfolioScope PortfolioScope
  followedUserId String?
  groupKey       String // deterministic key for aggregation group

  decision    CopyDecision
  reasonCodes String[] // non-empty when SKIP

  sourceType         CopySourceType @default(AGGREGATOR)
  bufferedTradeCount Int            @default(1) // meaningful when sourceType=BUFFER

  bookSource       BookSource?
  usedRestFallback Boolean     @default(false)

  // Decision-time spread (bestAsk - bestBid), in price micros. Useful when skipped due to SPREAD_TOO_WIDE.
  spreadMicrosAtDecision Int?

  targetNotionalMicros BigInt
  filledNotionalMicros BigInt @default(0)
  vwapPriceMicros      Int? // set when executed/partial
  filledRatioBps       Int    @default(0) // 0..10000

  theirReferencePriceMicros Int
  midPriceMicrosAtDecision  Int

  createdAt DateTime @default(now())

  followedUser FollowedUser?    @relation(fields: [followedUserId], references: [id], onDelete: Cascade)
  fills        ExecutableFill[]
  liveOrder    LiveOrder?

  @@unique([tradingMode, portfolioScope, followedUserId, groupKey])
  @@index([tradingMode, portfolioScope, createdAt])
  @@index([followedUserId, createdAt])
}

model ExecutableFill {
  id                 String @id @default(uuid())
  copyAttemptId      String
  filledShareMicros  BigInt
  fillPriceMicros    Int
  fillNotionalMicros BigInt

  copyAttempt CopyAttempt @relation(fields: [copyAttemptId], references: [id], onDelete: Cascade)

  @@index([copyAttemptId])
}

model LedgerEntry {
  id             String         @id @default(uuid())
  tradingMode    TradingMode    @default(PAPER)
  portfolioScope PortfolioScope
  followedUserId String?
  marketId       String?
  assetId        String?

  entryType LedgerEntryType

  shareDeltaMicros BigInt
  cashDeltaMicros  BigInt
  priceMicros      Int?

  refId     String
  createdAt DateTime @default(now())

  @@unique([tradingMode, portfolioScope, refId, entryType])
  @@index([tradingMode, portfolioScope, createdAt])
  @@index([assetId, createdAt])
  @@index([tradingMode, portfolioScope, assetId, entryType, createdAt])
}

model PortfolioSnapshot {
  id             String         @id @default(uuid())
  portfolioScope PortfolioScope
  followedUserId String?
  bucketTime     DateTime // minute-bucketed timestamp

  equityMicros        BigInt
  cashMicros          BigInt
  exposureMicros      BigInt
  unrealizedPnlMicros BigInt
  realizedPnlMicros   BigInt

  @@unique([portfolioScope, followedUserId, bucketTime])
  @@index([portfolioScope, bucketTime])
  @@index([followedUserId, bucketTime])
}

model MarketPriceSnapshot {
  id                  String   @id @default(uuid())
  assetId             String
  bucketTime          DateTime
  midpointPriceMicros Int

  @@unique([assetId, bucketTime])
  @@index([assetId, bucketTime])
}

model CurrentPrice {
  assetId             String   @id
  midpointPriceMicros Int
  updatedAt           DateTime @updatedAt
}

model CurrentPosition {
  id                String      @id @default(uuid())
  tradingMode       TradingMode @default(PAPER)
  assetId           String
  marketId          String?
  shareMicros       BigInt
  netCashFlowMicros BigInt
  updatedAt         DateTime    @updatedAt

  @@unique([tradingMode, assetId])
  @@index([tradingMode])
  @@index([marketId])
}

model CurrentPositionByLeader {
  id                String      @id @default(uuid())
  tradingMode       TradingMode @default(PAPER)
  assetId           String
  followedUserId    String
  marketId          String?
  shareMicros       BigInt
  netCashFlowMicros BigInt
  updatedAt         DateTime    @updatedAt

  @@unique([tradingMode, assetId, followedUserId])
  @@index([tradingMode, followedUserId])
  @@index([marketId])
}

model GlobalPortfolioState {
  id                       String         @id @default(uuid())
  tradingMode              TradingMode    @default(PAPER)
  portfolioScope           PortfolioScope @default(EXEC_GLOBAL)
  cashMicros               BigInt
  contributedCapitalMicros BigInt
  updatedAt                DateTime       @updatedAt

  @@unique([tradingMode, portfolioScope])
}

model EquityPoint {
  id                       String                 @id @default(uuid())
  tradingMode              TradingMode            @default(PAPER)
  granularity              EquityPointGranularity
  bucketTime               DateTime
  equityMicros             BigInt
  contributedCapitalMicros BigInt
  pnlMicros                BigInt
  updatedAt                DateTime               @updatedAt

  @@unique([tradingMode, granularity, bucketTime])
  @@index([tradingMode, granularity])
}

model SystemCheckpoint {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "alchemy:lastBlock" or "api:lastTradeTime:<userId>"
  valueJson Json
  updatedAt DateTime @updatedAt
}

model AllowedAdminEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// LIVE TRADING TABLES
// ============================================

model LiveOrder {
  id             String  @id @default(uuid())
  copyAttemptId  String? @unique
  followedUserId String?

  // Idempotency & exchange identifiers
  idempotencyKey String  @unique
  clientOrderId  String? @unique
  clobOrderId    String? @unique

  // Order parameters
  tokenId          String
  side             TradeSide
  orderType        LiveOrderType @default(FAK)
  limitPriceMicros Int
  sizeShareMicros  BigInt

  // Decision snapshot (for audit/debug)
  bestBidMicrosAtDecision Int?
  bestAskMicrosAtDecision Int?
  bookSource              BookSource?
  bookAgeMs               Int?

  // Fill tracking aggregates
  filledShareMicros    BigInt @default(0)
  filledNotionalMicros BigInt @default(0)
  avgFillPriceMicros   Int?

  // Lifecycle
  status       LiveOrderStatus @default(CREATED)
  createdAt    DateTime        @default(now())
  submittedAt  DateTime?
  lastUpdateAt DateTime?
  finalizedAt  DateTime?

  // Error fields
  lastErrorCode    String?
  lastErrorMessage String?

  // Relations
  copyAttempt  CopyAttempt?  @relation(fields: [copyAttemptId], references: [id], onDelete: SetNull)
  followedUser FollowedUser? @relation(fields: [followedUserId], references: [id], onDelete: SetNull)
  fills        LiveFill[]

  @@index([status])
  @@index([createdAt])
  @@index([tokenId, createdAt])
  @@index([followedUserId, createdAt])
}

model LiveFill {
  id          String         @id @default(uuid())
  liveOrderId String?
  origin      LiveFillOrigin @default(APP)

  // Exchange identifiers
  tradeId     String  @unique
  clobOrderId String?

  // Fill details
  tokenId        String
  side           TradeSide
  matchedAt      DateTime
  priceMicros    Int
  shareMicros    BigInt
  notionalMicros BigInt
  feeMicros      BigInt?

  // Status for processing
  status String @default("PENDING") // PENDING, PROCESSED, etc.

  createdAt DateTime @default(now())

  // Relations
  liveOrder LiveOrder? @relation(fields: [liveOrderId], references: [id], onDelete: SetNull)

  @@index([matchedAt])
  @@index([clobOrderId])
  @@index([tokenId, matchedAt])
  @@index([origin])
}

model TokenTradingParamsCache {
  tokenId                 String   @id
  tickSizeMicros          Int
  minOrderSizeShareMicros BigInt
  sizeStepShareMicros     BigInt   @default(1)
  updatedAt               DateTime @updatedAt

  @@index([updatedAt])
}
